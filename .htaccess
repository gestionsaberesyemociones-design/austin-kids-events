# Austin Kids Events - Apache .htaccess for Clean URLs (without .html)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect direct requests for .html files to the clean URL (e.g. /service-ranch.html -> /service-ranch)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.html [NC]
  RewriteRule ^ %1 [R=301,L]

  # If request is not a directory and corresponding .html file exists, serve it internally
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>
